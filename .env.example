# ─────────────────────────────────────────────────────────────
# ZúTa Ya — environment variable template.
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is gitignored). This template
# carries KEYS ONLY — no secret values.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth ──
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_NAME=Admin

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://www.zutayang.com/

# ── SMTP / Email (Zoho) ──
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Cron ──
CRON_SECRET=

# ── Cloudinary (image hosting) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Paystack ──
# Test: pk_test_/sk_test_  •  Live: pk_live_/sk_live_
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
